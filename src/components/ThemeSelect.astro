<div class="theme-control">
  <label class="sr-only" for="theme-select">Color theme</label>
  <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="3" y="4" width="18" height="13" rx="2" />
    <path d="M8 21h8m-4-4v4" />
  </svg>
  <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
  </svg>
  <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M20.7 13.2A9 9 0 0 1 10.8 3.3 9 9 0 1 0 20.7 13.2Z" />
  </svg>
  <select id="theme-select" name="theme">
    <option value="system">System</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
  <svg class="theme-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="m4 6 4 4 4-4" />
  </svg>
</div>

<script>
  const select = document.querySelector<HTMLSelectElement>('#theme-select');
  const control = document.querySelector<HTMLElement>('.theme-control');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let transitionTimer: number | undefined;
  type Preference = 'system' | 'light' | 'dark';

  function normalize(value: string | null | undefined): Preference {
    return value === 'light' || value === 'dark' ? value : 'system';
  }

  function apply(preference: Preference, animate = false) {
    const theme = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;

    if (animate && !reducedMotion.matches && root.dataset.theme !== theme) {
      window.clearTimeout(transitionTimer);
      root.classList.add('theme-changing');
      // Only clean up the transition styles; input stays available throughout.
      transitionTimer = window.setTimeout(() => root.classList.remove('theme-changing'), 200);
    }

    root.dataset.themePreference = preference;
    root.dataset.theme = theme;
    if (select) select.value = preference;
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
      meta.setAttribute('content', theme === 'dark' ? '#211f1b' : '#f8f5ee');
    });
  }

  apply(normalize(root.dataset.themePreference));

  select?.addEventListener('change', () => {
    const preference = normalize(select.value);
    apply(preference, true);
    try {
      if (preference === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', preference);
    } catch { /* The theme still works when browser storage is unavailable. */ }
  });

  media.addEventListener('change', () => {
    if (normalize(root.dataset.themePreference) === 'system') apply('system', true);
  });

  window.addEventListener('storage', (event) => {
    if (event.key === 'theme' || event.key === null) apply(normalize(event.newValue), true);
  });

  control?.setAttribute('data-ready', '');
</script>
