---
import { formatDate, formatTag, noteUrl, type Note } from '../lib/notes';
interface Props {
  notes: Note[];
}
const { notes } = Astro.props;
---

{notes.length === 0 ? (
  <p class="empty-state">Nothing here just yet. More soon.</p>
) : (
  <ol class="note-list">
    {notes.map((note) => (
      <li class="note-item">
        <time class="note-date" datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
        <article>
          <h3 class="note-title"><a href={noteUrl(note)}>{note.data.title}</a></h3>
          <p class="note-description">{note.data.description}</p>
          <div class="note-tags">
            {!note.data.published && <span class="unpublished-label">Unpublished</span>}
            {note.data.tags.map((tag) => <a href={`/tags/${tag}/`}>{formatTag(tag)}</a>)}
          </div>
        </article>
      </li>
    ))}
  </ol>
)}
