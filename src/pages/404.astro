---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="not-found">
    <p class="eyebrow">404 · A loose page</p>
    <h1>Nothing here, yet.</h1>
    <p>This page may have moved, or the link may be a little off.</p>
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to the notebook</a>
  </section>
</BaseLayout>
